# ── 数据库 ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://user:password@host:5432/openrag

# ── JWT ──────────────────────────────────────────────────────────────────────
# RS256 私钥文件路径（相对于 backend/），先执行: python scripts/generate_keys.py
JWT_PRIVATE_KEY_PATH=keys/private.pem

ACCESS_TOKEN_EXPIRE_SECONDS=7200
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── 初始管理员 ────────────────────────────────────────────────────────────────
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=          # 必填，不提供默认值

# ── Cookie ───────────────────────────────────────────────────────────────────
# 生产环境设为 true（需要 HTTPS）
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
# MINIO_BUCKET=factory-documents   # 默认值，可不填

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_API_URL=https://api.openai.com/v1

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=factory_chunks  # 默认值，可不填
