# ── 数据库 ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://user:password@host:5432/openrag

# ── JWT ──────────────────────────────────────────────────────────────────────
# RS256 私钥文件路径（相对于 backend/），先执行: python scripts/generate_keys.py
JWT_PRIVATE_KEY_PATH=keys/private.pem

ACCESS_TOKEN_EXPIRE_SECONDS=7200
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── 初始管理员 ────────────────────────────────────────────────────────────────
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=          # 必填，不提供默认值

# ── Cookie ───────────────────────────────────────────────────────────────────
# 生产环境设为 true（需要 HTTPS）
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
# MINIO_BUCKET=factory-documents   # 默认值，可不填

# ── LLM API（兼容 OpenAI 接口）────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_API_URL=https://api.deepseek.com

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=factory_chunks  # 默认值，可不填

# ── Chat / 检索参数 ───────────────────────────────────────────────────────────
OPENAI_CHAT_MODEL=deepseek-chat  # 切换模型只需改此项
# CHAT_HISTORY_WINDOW=5          # 多轮对话保留轮数，默认 5
# SEARCH_OVERSAMPLING_FACTOR=5   # 过采样倍率，候选池 = top_k × factor，默认 5
# SEARCH_CHUNKS_PER_DOC=20       # 阶段二每文档最多补全 chunk 数，需覆盖单文档最多页数，默认 20

# ── Reranker（sentence-transformers）─────────────────────────────────────────
# 首次运行自动从 HuggingFace 下载（约 1.1 GB），或填本地绝对路径跳过下载
# RERANKER_MODEL_PATH=BAAI/bge-reranker-v2-m3
# 模型加载完成后推理约 300–1000ms，默认 10s 足够；首次下载期间建议临时调大
# RERANKER_TIMEOUT_S=10
